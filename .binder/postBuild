#!/bin/bash
set -e

# Scarica e registra il kernel Java per Jupyter (JJava)
JJAVA_VERSION="1.0-a8"
echo "Download JJava kernel versione ${JJAVA_VERSION}..."
curl -L -o /tmp/jjava.zip "https://github.com/dflib/jjava/releases/download/${JJAVA_VERSION}/jjava-${JJAVA_VERSION}-kernelspec.zip"

mkdir -p /tmp/jjava
unzip -q /tmp/jjava.zip -d /tmp/jjava

echo "Installazione del kernel Java in Jupyter..."
jupyter kernelspec install /tmp/jjava --sys-prefix --name=java

rm -rf /tmp/jjava /tmp/jjava.zip
echo "Kernel Java configurato con successo!"
